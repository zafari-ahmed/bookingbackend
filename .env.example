APP_NAME="District Coordination CMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Asia/Karachi

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=case_system
DB_USERNAME=root
DB_PASSWORD=

# Separate schema used by the test suite (RefreshDatabase truncates it).
DB_TEST_DATABASE=case_system_testing

SESSION_DRIVER=database
# Government portal: 2 hour idle timeout, not a consumer "stay logged in forever" app.
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict

BROADCAST_CONNECTION=log

# Attachments live on the "private" disk (storage/app/private), never in public/.
FILESYSTEM_DISK=private

# Swap to "redis" once throughput demands it; no application code changes required.
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@dc-cms.sindh.gov.pk"
MAIL_FROM_NAME="${APP_NAME}"

# Two-factor authentication is mandatory for these roles.
FORTIFY_TWO_FACTOR_REQUIRED_ROLES=super_admin,department_admin

# Attachment upload ceiling in kilobytes.
UPLOAD_MAX_KILOBYTES=10240

# AC office service standard: open cases older than this are flagged overdue.
CASE_OVERDUE_AFTER_DAYS=15

VITE_APP_NAME="${APP_NAME}"
